{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@sistema/core-llm": ["packages/core-llm/src/index.ts"],
      "@sistema/core-agents": ["packages/core-agents/src/index.ts"],
      "@sistema/guardrails": ["packages/guardrails/src/index.ts"],
      "@sistema/deck": ["packages/deck/src/index.ts"],
      "@sistema/deck/pdf": ["packages/deck/src/pdf.ts"],
      "@sistema/db": ["packages/db/src/index.ts"],
      "@/*": ["apps/web/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx"
  ]
}
